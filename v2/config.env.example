# ============================================================
# STARK MONITOR V2 - CONFIGURATION
# ============================================================
#
# Скопируйте этот файл в config.env:
# cp config.env.example config.env
#
# config.env не должен попадать в Git.
# ============================================================

# Путь к USB-RS232 адаптеру.
# Обычно PL2303 определяется как /dev/ttyUSB0.
STARK_SERIAL_PORT=/dev/ttyUSB0

# Скорость RS232. Для STARK COUNTRY 2000 INV MAX: 2400.
STARK_SERIAL_BAUD=2400

# Максимальное время ожидания ответа инвертора, секунд.
STARK_SERIAL_TIMEOUT=3.0

# Интервал опроса инвертора, секунд.
STARK_POLL_INTERVAL=2

# Интервал сохранения измерений в SQLite, секунд.
STARK_DB_SAVE_INTERVAL=30

# Интервал очистки старых записей, секунд.
# 86400 = один раз в сутки.
STARK_CLEANUP_INTERVAL=86400

# Путь к базе SQLite.
STARK_DB_PATH=/home/pi/stark_monitor.db

# Срок хранения истории в днях.
STARK_RETENTION_DAYS=90

# Web-интерфейс.
# 0.0.0.0 = принимать подключения на всех интерфейсах.
STARK_WEB_HOST=0.0.0.0

# TCP-порт Web-интерфейса.
STARK_WEB_PORT=8080

# Database synchronization
STARK_DB_SYNC_ENABLED=false
STARK_DB_SYNC_HOST=10.10.0.1
STARK_DB_SYNC_PORT=22
STARK_DB_SYNC_USER=pi
STARK_DB_SYNC_DB_PATH=/home/pi/stark_monitor.db
STARK_DB_SYNC_INTERVAL=3600
